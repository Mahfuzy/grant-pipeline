# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=fundscout
POSTGRES_PASSWORD=fundscout
POSTGRES_DB=fundscout
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fundscout:fundscout@localhost:5432/fundscout

# --- LLM extraction ---
# Provider: anthropic (default) or groq. EXTRACTION_MODEL is the provider's model name,
# e.g. claude-sonnet-5 (anthropic) or openai/gpt-oss-120b (groq).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Set to false for Groq models without strict structured-output support.
GROQ_STRICT_OUTPUT=true
EXTRACTION_MODEL=claude-sonnet-5

# --- Responsible collection ---
# Included in the User-Agent so site owners can contact us.
CONTACT_EMAIL=change-me@example.com
DEFAULT_RATE_LIMIT_SECONDS=3.0
HTTP_TIMEOUT_SECONDS=30

# --- Raw snapshot storage ---
RAW_STORAGE_DIR=data/raw

# --- Dedup / review thresholds ---
DEDUP_MATCH_THRESHOLD=90
DEDUP_POSSIBLE_DUPLICATE_THRESHOLD=75
DEDUP_DATE_TOLERANCE_DAYS=31
REVIEW_LOW_CONFIDENCE_THRESHOLD=0.6
MISSING_RUNS_BEFORE_REVIEW=3
FETCH_FAILURES_BEFORE_REVIEW=3

# --- Internal API ---
# Required: the API refuses requests without it. Also used by the admin UI.
API_KEY=
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
